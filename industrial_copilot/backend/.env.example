# ============================================
# Zynaptrix Industrial Copilot - Backend Configuration
# ============================================
# Copy this file to .env and fill in your values

# ── OpenAI Configuration ──────────────────────────────────────────────────────
# Required for: GPT-4o diagnosis, PDF captioning, text embeddings
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── PostgreSQL Database (with pgvector extension) ─────────────────────────────
# Required for: Machine registry, anomaly records, chat history, vector storage
# Format: postgresql://username:password@host:port/database
# Recommended: Neon (https://neon.tech) or Supabase for managed pgvector
DATABASE_URL=postgresql://user:password@localhost:5432/industrial_copilot

# ── InfluxDB Configuration ────────────────────────────────────────────────────
# Required for: High-frequency sensor telemetry storage (10Hz writes)
# Get these from: InfluxDB Cloud Console → API Tokens
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=your-organization-name
INFLUX_BUCKET=sensor_data

# ── Service URLs ──────────────────────────────────────────────────────────────
# API_URL: Used by simulator to push telemetry (default: http://127.0.0.1:8000)
# FRONTEND_URL: Used for CORS configuration (default: http://127.0.0.1:3000)
API_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000

# ── Optional: Model Configuration ─────────────────────────────────────────────
# Anomaly detection threshold (lower = more sensitive)
# ANOMALY_THRESHOLD=0.02

# Consecutive anomalies before escalation
# CONSECUTIVE_THRESHOLD=3

# ── Optional: Logging ─────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
